# Copy this file to .env and fill in your actual values

# Retell AI API Key (required for webhook signature verification)
# Get this from your Retell AI dashboard
RETELL_API_KEY=your_retell_api_key_here

# Server port (optional, defaults to 5000)
PORT=5000

# Database path (optional, defaults to ./agent.db)
DATABASE_PATH=./agent.db

# For production deployment, you might also need:
# NODE_ENV=production